#!name = telegram 跳转
#!desc = 将 t.me / telegram.me 302 到选择的客户端
#!author = Saul

[Script]
tme_to_nagram = type=http-request, pattern=^https?:\/\/(t\.me|telegram\.me|telegram\.dog)\/.+, requires-body=false, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TgRedirect.js, argument=client=tg

[MITM]
hostname = %APPEND% t.me, telegram.me, telegram.dog




tme_redirect = type=http-request, pattern=^https?:\/\/t\.me\/.+, requires-body=0, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TgRedirect.js, argument=client=Swiftgram